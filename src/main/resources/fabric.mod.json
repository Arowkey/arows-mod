{
	"schemaVersion": 1,
	"id": "arows",
	"version": "${version}",
	"name": "Arows",
	"description": "Arows, a Fabric mod for Minecraft.",
	"authors": [
		"Marco Heiling"
	],
	"contact": {
		"sources": "https://github.com/Arowkey/arows-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/arows/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.marcoheiling.arows.ArowsMod"
		],
		"client": [
			"dev.marcoheiling.arows.client.ArowsModClient"
		]
	},
	"mixins": [
		"arows.mixins.json",
		{
			"config": "arows.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
