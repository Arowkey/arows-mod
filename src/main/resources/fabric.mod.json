{
	"schemaVersion": 1,
	"id": "arowsmod",
	"version": "${version}",
	"name": "ArowsMod",
	"description": "This is a mod made by Arowkey with various features!",
	"authors": [
		"Arowkey"
	],
	"contact": {
		"homepage": "https://github.com/arowkey",
		"sources": "https://github.com/arowkey/arows-mod"
	},
	"license": "LGPL-3.0",
	"icon": "assets/arowsmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.arowkey.arowsmod.ArowsMod"
		],
		"client": [
			"com.arowkey.arowsmod.client.ArowsModClient"
		]
	},
	"mixins": [
		"arowsmod.mixins.json",
		{
			"config": "arowsmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.0",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
